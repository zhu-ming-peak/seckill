# 配置变量示例；本文件不被自动加载。本机入口读取项目外 JSON 并注入环境。
# 复制到本机私用配置后填写密码，禁止提交真实凭据。
APP_PORT=18092
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lab2_seckill
DB_USER=lab2_app
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true
PRODUCT_CACHE_TTL_SECONDS=60
REDIS_PREFIX=lab2:v2:
# WSL/云端地址在实际网络验证后填写，不预设 Broker 通告地址。
ROCKETMQ_NAMESRV_ADDR=

